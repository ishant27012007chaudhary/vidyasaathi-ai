        {"id": "L4-2", "q": {"en": "36 mangoes shared equally by 6 children. Each gets?", "hi": "36 आम 6 बच्चों में बराबर बाँटे। हर एक को कितने?"}, "options": ["5", "6", "30"], "answer": "6", "hint": {"en": "Which number times 6 makes 36?", "hi": "6 को किस संख्या से गुणा करें तो 36 बने?"}},
        {"id": "L4-3", "q": {"en": "95 / 5 = ?", "hi": "95 / 5 = ?"}, "options": ["17", "19", "21"], "answer": "19", "hint": {"en": "100 / 5 = 20, and 95 is 5 less.", "hi": "100 / 5 = 20, और 95 उससे 5 कम है।"}},
        {"id": "L4-4", "q": {"en": "What is the remainder when 29 is divided by 4?", "hi": "29 को 4 से भाग देने पर शेषफल क्या है?"}, "options": ["1", "3", "7"], "answer": "1", "hint": {"en": "4 x 7 = 28. What is left?", "hi": "4 x 7 = 28। कितना बचा?"}}
      ]
    },
