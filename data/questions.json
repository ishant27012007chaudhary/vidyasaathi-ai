        {"id": "L3-2", "q": {"en": "A packet has 6 biscuits. How many in 9 packets?", "hi": "एक पैकेट में 6 बिस्कुट हैं। 9 पैकेट में कितने?"}, "options": ["54", "15", "45"], "answer": "54", "hint": {"en": "Equal groups -> multiply: 9 x 6.", "hi": "बराबर समूह -> गुणा: 9 x 6।"}},
        {"id": "L3-3", "q": {"en": "23 x 4 = ?", "hi": "23 x 4 = ?"}, "options": ["82", "92", "812"], "answer": "92", "hint": {"en": "20 x 4 = 80 and 3 x 4 = 12.", "hi": "20 x 4 = 80 और 3 x 4 = 12।"}},
        {"id": "L3-4", "q": {"en": "12 x 5 = ?", "hi": "12 x 5 = ?"}, "options": ["60", "50", "17"], "answer": "60", "hint": {"en": "10 x 5 = 50, 2 x 5 = 10.", "hi": "10 x 5 = 50, 2 x 5 = 10।"}}
      ]
    },
