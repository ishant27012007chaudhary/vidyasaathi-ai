        {"id": "L5-2", "q": {"en": "Which is bigger: 1/2 or 1/3?", "hi": "कौन बड़ा है: 1/2 या 1/3?"}, "options": ["1/2", "1/3"], "answer": "1/2", "hint": {"en": "A roti cut into 2 pieces gives bigger pieces than one cut into 3.", "hi": "2 टुकड़ों वाली रोटी के टुकड़े 3 टुकड़ों वाली से बड़े होते हैं।"}},
        {"id": "L5-3", "q": {"en": "A pen costs Rs 12. How much for 5 pens with Rs 100 paid - what change?", "hi": "एक पेन Rs 12 का है। 5 पेन के लिए Rs 100 दिए, कितने वापस मिलेंगे?"}, "options": ["Rs 40", "Rs 60", "Rs 88"], "answer": "Rs 40", "hint": {"en": "First 5 x 12, then subtract from 100.", "hi": "पहले 5 x 12, फिर 100 में से घटाओ।"}},
        {"id": "L5-4", "q": {"en": "3/4 of 12 = ?", "hi": "12 का 3/4 = ?"}, "options": ["9", "3", "8"], "answer": "9", "hint": {"en": "1/4 of 12 is 3. Three of those?", "hi": "12 का 1/4 = 3। ऐसे तीन हिस्से?"}}
      ]
    }
