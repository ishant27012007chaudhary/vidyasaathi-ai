        {"id": "L2-2", "q": {"en": "52 - 18 = ?", "hi": "52 - 18 = ?"}, "options": ["34", "46", "44"], "answer": "34", "hint": {"en": "You can't take 8 from 2, so borrow 1 ten.", "hi": "2 में से 8 नहीं घटता, इसलिए 1 दहाई उधार लो।"}},
        {"id": "L2-3", "q": {"en": "Riya had 45 marbles and got 19 more. How many now?", "hi": "रिया के पास 45 कंचे थे, उसे 19 और मिले। अब कितने हैं?"}, "options": ["54", "64", "26"], "answer": "64", "hint": {"en": "'Got more' means add.", "hi": "'और मिले' का मतलब जोड़ना है।"}},
        {"id": "L2-4", "q": {"en": "70 - 25 = ?", "hi": "70 - 25 = ?"}, "options": ["45", "55", "50"], "answer": "45", "hint": {"en": "70 - 20 = 50, then 50 - 5.", "hi": "70 - 20 = 50, फिर 50 - 5।"}}
      ]
    },
