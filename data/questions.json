      "questions": [
        {"id": "L1-1", "q": {"en": "Which number is bigger: 47 or 74?", "hi": "कौन-सी संख्या बड़ी है: 47 या 74?"}, "options": ["47", "74"], "answer": "74", "hint": {"en": "Compare the tens digit first: 4 tens or 7 tens?", "hi": "पहले दहाई का अंक देखो: 4 दहाई या 7 दहाई?"}},
        {"id": "L1-2", "q": {"en": "What comes after 59?", "hi": "59 के बाद कौन-सी संख्या आती है?"}, "options": ["58", "60", "69"], "answer": "60", "hint": {"en": "After 9 ones, we make one more ten.", "hi": "9 इकाई के बाद एक नई दहाई बनती है।"}},
        {"id": "L1-3", "q": {"en": "How many tens are in 83?", "hi": "83 में कितनी दहाइयाँ हैं?"}, "options": ["3", "8", "83"], "answer": "8", "hint": {"en": "The left digit tells the tens.", "hi": "बाईं ओर का अंक दहाई बताता है।"}},
        {"id": "L1-4", "q": {"en": "Which is the smallest: 31, 13, 30?", "hi": "सबसे छोटी संख्या कौन-सी है: 31, 13, 30?"}, "options": ["31", "13", "30"], "answer": "13", "hint": {"en": "Look for the number with the fewest tens.", "hi": "सबसे कम दहाई वाली संख्या खोजो।"}}
      ]
    },
